ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://aashiyana:aashiyana@localhost:5432/aashiyana
CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api
FIREBASE_PROJECT_ID=aashiyana
# JSON string of Firebase Admin SDK service account; keep only in backend secret store
